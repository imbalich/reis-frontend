VITE_BASE=/

# 接口地址 - 风电版部署入口(nginx 同源反代 /api/v1 → fba_server_wind:8001)
VITE_GLOB_API_URL=http://172.30.1.148:8080

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
